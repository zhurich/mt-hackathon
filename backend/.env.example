# Скопируйте в backend/.env и измените под себя. Файл .env в git не попадает.

# dev | prod. В prod приложение не запустится с JWT_SECRET по умолчанию.
APP_ENV=dev

# SQLite по умолчанию; для PostgreSQL: postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./vsm.db

# Секрет подписи JWT — длинная случайная строка (например: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=720

# Адреса frontend, которым разрешены запросы (JSON-список)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Демо-данные (синтетические сотрудники и история). В бою — false.
SEED_DEMO=true
DEMO_PASSWORD=vsm2026
DEMO_INTEGRATION_KEY=demo-integration-key

# Баллы рейтинга сгорают через N дней, предупреждение — за M дней
POINTS_TTL_DAYS=30
POINTS_EXPIRY_WARNING_DAYS=5
